# Testing Environment - candash.adlr.ir
# Use this file for testing - does NOT affect production .env
# Usage: cp .env.testing .env.testing.local (for custom overrides)

# ===== Application =====
APP_NAME=TalentMatch
APP_ENV=testing
APP_KEY=base64:dGVzdHRlc3R0ZXN0dGVzdHRlc3R0ZXN0dGVzdHRlc3Q=
APP_DEBUG=true
APP_URL=http://localhost:8082
APP_TIMEZONE=Asia/Tehran
APP_LOCALE=fa
APP_FALLBACK_LOCALE=en

# ===== Ports =====
API_PORT=8082
FRONTEND_PORT=3080
DB_PORT=5432
REDIS_PORT=6379
MOCK_PORT=4000

# ===== Database (separate from production) =====
DB_CONNECTION=pgsql
DB_HOST=db
DB_DATABASE=talentmatch_testing
DB_USERNAME=talentmatch
DB_PASSWORD=talentmatch_secret

# ===== Redis =====
REDIS_HOST=redis
REDIS_PORT=6379
CACHE_DRIVER=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis

# ===== Testing =====
TESTING=true
BROWSER_TESTING=false

# ===== Job Source (mock for testing) =====
JOBSOURCE_DRIVER=mock
JOBSOURCE_BASE_URL=http://mock-jobsource:4000

# ===== AI =====
AI_DRIVER=mock

# ===== Sanctum =====
SANCTUM_STATEFUL_DOMAINS=localhost:3000,127.0.0.1:3000
SESSION_DOMAIN=localhost