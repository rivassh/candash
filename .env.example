# ===== Application =====
APP_NAME=TalentMatch
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8082
APP_TIMEZONE=Asia/Tehran
APP_LOCALE=fa
APP_FALLBACK_LOCALE=en

# ===== Ports =====
API_PORT=8082
FRONTEND_PORT=3080
DB_PORT=5432
REDIS_PORT=6379
MOCK_PORT=4000

# ===== Database =====
DB_CONNECTION=pgsql
DB_HOST=db
DB_DATABASE=talentmatch
DB_USERNAME=talentmatch
DB_PASSWORD=talentmatch_secret

# ===== Redis =====
REDIS_HOST=redis
REDIS_PORT=6379
CACHE_DRIVER=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis

# ===== Sanctum =====
SANCTUM_STATEFUL_DOMAINS=localhost:3000,127.0.0.1:3000
SESSION_DOMAIN=localhost
FRONTEND_URL=http://localhost:3000

# ===== JobSource Contract =====
JOBSOURCE_DRIVER=mock
JOBSOURCE_BASE_URL=http://mock-jobsource:4000
JOBSOURCE_API_TOKEN=

# ===== JobVision (for JobVision driver) =====
JOBVISION_TOKEN=
JOBVISION_USERNAME=
JOBVISION_PASSWORD=
JOBVISION_CAPTCHA_TOKEN=
JOBVISION_COOKIE=
JOBVISION_ACCOUNT_URL=https://account.jobvision.ir
JOBVISION_API_URL=https://employerapi.jobvision.ir

# ===== Simple JobVision API (feature flag) =====
USE_NEW_JOBVISION_API=false
JOBVISION_SIMPLE_BASE_URL=https://api.jobvision.com
JOBVISION_SIMPLE_PAGE_SIZE=50

# ===== JobVision Simple API (no auth, direct) =====
USE_NEW_JOBVISION_API=false
JOBVISION_SIMPLE_BASE_URL=https://api.jobvision.com
JOBVISION_SIMPLE_ENDPOINT=api/v1.0/JobPost/GetListOfJobPosts
JOBVISION_SIMPLE_PAGE_SIZE=50
JOBVISION_SIMPLE_SOURCE_KEY=jobvision
JOBVISION_SIMPLE_CORPUS_KEY=job_posts

# ===== AI / Enrichment (all mocked) =====
AI_DRIVER=mock
RESUME_EXTRACTOR_DRIVER=mock
ENRICHMENT_DRIVER=mock

# ===== Logging =====
LOG_CHANNEL=stack
LOG_LEVEL=debug